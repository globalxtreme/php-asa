{
  "name": "globalxtreme/php-asa",
  "description": "GlobalXtreme ASA Automation Package for PHP Language",
  "license": "MIT",
  "authors": [
    {
      "name": "Yuswa",
      "email": "yuswa98@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "GlobalXtreme\\ASA\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "GlobalXtreme\\ASA\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^7.4|^8.0",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "suggest": {
    "illuminate/support": "Laravel 7 or newer: registers the service provider and config/asa.php automatically"
  },
  "extra": {
    "laravel": {
      "providers": [
        "GlobalXtreme\\ASA\\ASAServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
